{
    "extends": [
        "plugin:@mattermost/react"
    ],
    "plugins": [
        "@mattermost",
        "@typescript-eslint",
        "import",
        "react",
        "react-hooks"
    ],
    "settings": {
        "import/resolver": {
            "node": {
                "moduleDirectory": [
                    "node_modules",
                    "src"
                ],
                "extensions": [
                    ".js",
                    ".jsx",
                    ".ts",
                    ".tsx"
                ]
            }
        },
        "react": {
            "version": "detect"
        }
    },
    "rules": {
        "import/no-unresolved": "off",
        "no-unused-vars": "off",
        "@typescript-eslint/no-unused-vars": [
            "error",
            {
                "vars": "all",
                "args": "after-used"
            }
        ],
        "no-undefined": "off",
        "react/prop-types": "off",
        "react/jsx-filename-extension": "off",
        "no-use-before-define": "off",
        "max-lines": "off",
        "no-shadow": "off",
        "react/require-optimization": "off",
        "no-redeclare": "off",
        "react/no-multi-comp": "off",
        "func-names": "off",
        "no-magic-numbers": "off",
        "react/display-name": "off",
        "max-nested-callbacks": "off",
        "no-console": "error",
        "header/header": "off",
        "@mattermost/use-external-link": "off"
    },
    "parser": "@typescript-eslint/parser",
    "env": {
        "browser": true,
        "es6": true,
        "jest": true,
        "node": true
    },
    "parserOptions": {
        "ecmaVersion": 2020,
        "sourceType": "module",
        "ecmaFeatures": {
            "jsx": true
        }
    },
    "ignorePatterns": [
        "src/manifest.ts",
        "webpack.config.js",
        "babel.config.js"
    ]
}